{
  "name": "sandbagged",
  "private": true,
  "version": "9.94.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:html": "node scripts/build-html.mjs",
    "sim": "node sim/run.mjs",
    "test": "node sim/test-core.mjs && node sim/test.mjs",
    "check": "tsc --noEmit && node sim/test-core.mjs && node sim/test.mjs",
    "ship": "npm run check && vite build && npm run build:html"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  },
  "description": "A climbing card battler. The route is the opponent.",
  "homepage": "https://rcjlabs.github.io/Sandbagged/",
  "repository": {
    "type": "git",
    "url": "https://github.com/RCJLabs/Sandbagged.git"
  }
}
