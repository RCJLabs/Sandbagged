node_modules/
dist/
sim/_*.mjs

# SHIP-3: Bubblewrap output and the signing key. The keystore especially — committing it
# hands anyone who clones the repo the ability to sign a release as us, and on Play App
# Signing it is the upload key, so losing control of it is not recoverable by rotating.
ship/*.keystore
ship/*.jks
ship/*.apk
ship/*.aab
ship/app/
ship/build/
ship/.gradle/
ship/gradlew*
ship/gradle/

# The seeded design canvas is a build artefact: ~2.5 MB of editor payload wrapped
# around the .dc.html sources beside it, regenerated by seed-canvas.mjs. The
# artboards and canvas.json ARE the source and are tracked.
design/**/sandbagged-*.html
